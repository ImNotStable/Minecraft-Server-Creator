import xyz.jpenilla.resourcefactory.bukkit.Permission

plugins {
    java
    alias(libs.plugins.run.paper)
    // Paper's server with Minecraft internals (NMS) and CraftBukkit to compile against, Mojang-named.
    alias(libs.plugins.paperweight)
    // Writes plugin.yml from the bukkitPluginYaml block below and checks it at build time.
    alias(libs.plugins.resource.factory)
}

group = "{{packageName}}"
version = "{{version}}"
description = "{{description}}"

java {
    toolchain.languageVersion = JavaLanguageVersion.of(libs.versions.java.get().toInt())
}

paperweight {
    // The server is for compiling only: MockBukkit tests run against paper-api, and NMS code runs on the dev server.
    addServerDependencyTo = configurations.named(JavaPlugin.COMPILE_ONLY_CONFIGURATION_NAME).map { setOf(it) }
}

repositories {
    mavenCentral()
    maven("https://repo.papermc.io/repository/maven-public/")
    // msc-stdlib, shipped with the project.
    maven(uri("libs/repo")) {
        content { includeGroup("io.github.imnotstable.msc") }
    }
}

dependencies {
    paperweight.paperDevBundle(libs.versions.paper.get())
    // Bundled into the plugin jar (see tasks.jar); Paper itself provides slf4j.
    implementation(libs.msc.stdlib.paper) {
        exclude(group = "org.slf4j")
    }

    testImplementation(libs.paper.api)
    testImplementation(libs.mockbukkit)
    testImplementation(platform(libs.junit.bom))
    testImplementation(libs.junit.jupiter)
    testImplementation(libs.assertj)
    testRuntimeOnly(libs.junit.platform.launcher)
    testRuntimeOnly(libs.sqlite.jdbc)
}

// Every implementation dependency goes inside the plugin jar (Paper gives each plugin its own class loader).
// Declare libraries Paper already has (Adventure, Gson, the SQLite and MySQL drivers) compileOnly instead.
tasks.jar {
    duplicatesStrategy = DuplicatesStrategy.EXCLUDE
    from(configurations.runtimeClasspath.map { cp -> cp.files.map(::zipTree) }) {
        exclude("META-INF/**", "module-info.class")
    }
}

tasks.withType<JavaCompile>().configureEach {
    options.encoding = "UTF-8"
    options.release = libs.versions.java.get().toInt()
    options.compilerArgs.addAll(listOf("-parameters", "-Xlint:all,-processing,-serial"))
}

// plugin.yml, generated at build time (version and description come from the project above).
bukkitPluginYaml {
    name = "{{name}}"
    main = "{{packageName}}.{{mainClass}}"
    apiVersion = libs.versions.minecraft
    "{{author}}".takeIf { it.isNotBlank() }?.let { authors.add(it) }
    permissions.register("{{projectId}}.admin") {
        description = "Use /game (status, stage jumps, kit, reset)."
        default = Permission.Default.OP
    }
}

tasks.test {
    useJUnitPlatform()
    jvmArgs("--enable-native-access=ALL-UNNAMED") // sqlite-jdbc loads its native library
    // Short output: only failures, with the full exception.
    testLogging {
        events("failed")
        exceptionFormat = org.gradle.api.tasks.testing.logging.TestExceptionFormat.FULL
    }
}

tasks.runServer {
    // Dev server lives in run/ (server.properties and eula.txt are already there).
    // It starts only after the owner accepts the Minecraft EULA in run/eula.txt.
    minecraftVersion(libs.versions.minecraft.get())
    jvmArgs("-Xms1G", "-Xmx2G")
}
